+++ b/src/loans/loan.routes.js
@@ -0,0 +1,23 @@
+import { Router } from "express";
+
+export function createLoanRouter(loanService) {
+  const router = Router();
+
+  router.get("/", async (req, res, next) => {
+    try {
+      res.json(await loanService.listLoans());
+    } catch (error) {
+      next(error);
+    }
+  });
+
+  router.post("/", async (req, res, next) => {
+    try {
+      res.status(201).json(await loanService.createLoan(req.body));
+    } catch (error) {
+      next(error);
+    }
+  });
+
+  return router;
+}
diff --git a/src/loans/loan.service.js b/src/loans/loan.service.js
new file mode 100644
index 0000000..086a27e
--- /dev/null
+++ b/src/loans/loan.service.js
@@ -0,0 +1,90 @@
+import { AppError } from "../shared/app-error.js";
+import { addDays, formatDate, parseDate } from "../shared/date.js";
+import { runInTransaction } from "../shared/transaction.js";
+
+const LOAN_DAYS = 14;
+const MAX_OPEN_LOANS = 3;
+
+export class LoanService {
+  constructor(loanRepository, bookRepository, userRepository) {
+    this.loanRepository = loanRepository;
+    this.bookRepository = bookRepository;
+    this.userRepository = userRepository;
+  }
+
+  async listLoans() {
+    return this.loanRepository.findAll();
+  }
+
+  async createLoan(input) {
+    const userId = parseId(input?.userId);
+    const bookId = parseId(input?.bookId);
+    const currentDate = parseDate(input?.currentDate);
+
+    if (userId === null || bookId === null || currentDate === null) {
+      throw new AppError("INVALID_LOAN", 400);
+    }
+
+    const user = await this.userRepository.findById(userId);
+    if (!user) {
+      throw new AppError("USER_NOT_FOUND", 404);
+    }
+
+    const book = await this.bookRepository.findOne({ id: bookId });
+    if (!book) {
+      throw new AppError("BOOK_NOT_FOUND", 404);
+    }
+
+    if (book.availableCopies <= 0) {
+      throw new AppError("BOOK_UNAVAILABLE", 409);
+    }
+
+    book.availableCopies -= 1;
+
+    const loans = await this.loanRepository.findByUser(userId);
+    if (loans.length >= MAX_OPEN_LOANS) {
+      throw new AppError("LOAN_LIMIT_REACHED", 409);
+    }
+
+    const openLoans = await this.loanRepository.findOpenByUser(userId);
+    const operationDate = formatDate(currentDate);
+    if (openLoans.some((loan) => loan.dueDate <= operationDate)) {
+      throw new AppError("OVERDUE_LOAN", 409);
+    }
+
+    const duplicatedBook = await this.loanRepository.findByUserAndBook(
+      userId,
+      bookId
+    );
+    if (duplicatedBook) {
+      throw new AppError("BOOK_ALREADY_BORROWED", 409);
+    }
+
+    const loan = {
+      userId,
+      bookId,
+      loanDate: operationDate,
+      dueDate: formatDate(addDays(new Date(), LOAN_DAYS)),
+      returnDate: null,
+      renewalCount: 0,
+    };
+
+    return this.persistLoan(loan, book);
+  }
+
+  async persistLoan(loan, book) {
+    return runInTransaction(
+      [this.loanRepository, this.bookRepository],
+      async () => {
+        const createdLoan = await this.loanRepository.save(loan);
+        await this.bookRepository.save(book);
+        return createdLoan;
+      }
+    );
+  }
+}
+
+function parseId(value) {
+  const id = Number(value);
+  return Number.isInteger(id) && id > 0 ? id : null;
+}
diff --git a/src/shared/date.js b/src/shared/date.js
new file mode 100644
index 0000000..5149d89
--- /dev/null
+++ b/src/shared/date.js
@@ -0,0 +1,18 @@
+export function parseDate(value) {
+  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return null;
+  }
+
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return Number.isNaN(date.getTime()) || formatDate(date) !== value ? null : date;
+}
+
+export function addDays(date, days) {
+  const result = new Date(date);
+  result.setUTCDate(result.getUTCDate() + days);
+  return result;
+}
+
+export function formatDate(date) {
+  return date.toISOString().slice(0, 10);
+}
diff --git a/src/shared/transaction.js b/src/shared/transaction.js
new file mode 100644
index 0000000..cc90f39
--- /dev/null
+++ b/src/shared/transaction.js
@@ -0,0 +1,10 @@
+export async function runInTransaction(repositories, operation) {
+  const snapshots = repositories.map((repository) => repository.snapshot());
+
+  try {
+    return await operation();
+  } catch (error) {
+    repositories.forEach((repository, index) => repository.restore(snapshots[index]));
+    throw error;
+  }
+}
